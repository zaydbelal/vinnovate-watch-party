{
  "name": "vinnovate-watch-party",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time watch party: synchronized playback, chat, reactions, playlists, polls and movie discovery.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "npm test -w server",
    "bench": "tsx scripts/latency-bench.ts",
    "e2e": "node scripts/e2e-sync.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
